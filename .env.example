# ---- 可选项，全部留空也能正常构建与运行 ----

# 实时功能（多人光标 / 聊天室 / 小游戏）的 WebSocket 服务地址。
# 留空 = 这些入口完全不渲染，页面其余部分不受影响。
# 例：NEXT_PUBLIC_WS_URL=wss://your-worker.example.workers.dev
NEXT_PUBLIC_WS_URL=

# Umami 统计。不填 UMAMI_SITE_ID 就完全不加载脚本。
UMAMI_DOMAIN=
UMAMI_SITE_ID=

# 旧域名迁移提示。留空 = 不显示任何提醒。
# NEXT_PUBLIC_LEGACY_HOST=old.example.com
NEXT_PUBLIC_LEGACY_HOST=

# ---- 构建期变量 ----

# 站点部署在子路径时使用（如 GitHub Pages 项目页 /<仓库名>/）。
# 部署在域名根目录时留空。
# NEXT_PUBLIC_BASE_PATH=/adam-3d-portfolio
NEXT_PUBLIC_BASE_PATH=
